# ============================================================
# TECHPHILO — Email Service Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is already in .gitignore.
# ============================================================

# --- Resend ---
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender addresses (domain must be verified in Resend).
# On Resend's free tier you can also use: onboarding@resend.dev for testing.
CONTACT_FROM=TechPhilo Website <noreply@techphilo.in>
DEMO_FROM=TechPhilo Website <noreply@techphilo.in>

# Recipient addresses for each form type.
CONTACT_TO_EMAIL=techphilo.tp@gmail.com
DEMO_TO_EMAIL=techphilo.tp@gmail.com