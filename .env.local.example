# ============================================================
# TECHPHILO — Email Service Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is already in .gitignore.
# ============================================================

# --- Nodemailer + Gmail ---
# The Gmail address that sends the emails (appears as the "from" address).
GMAIL_USER=techphilo.tp@gmail.com


# A Gmail App Password — NOT your regular Gmail password.
# How to generate one:
#   1. Go to: https://myaccount.google.com/apppasswords
#   2. Sign in with itstechphilo@gmail.com
#   3. Under "Select app" choose "Mail", under "Select device" choose "Other" → name it "TechPhilo Website"
#   4. Click Generate — you'll get a 16-character password. Paste it below.
GMAIL_APP_PASS=ydwa rbea mcna mwtb

# Optional: override the "to" address for each form type.
# Defaults to GMAIL_USER if not set.
DEMO_TO_EMAIL=techphilo.tp@gmail.com

CONTACT_TO_EMAIL=techphilo.tp@gmail.com