# ============================================================
# TECHPHILO — Render Environment Variables
# ============================================================
# Set these key-value pairs in Render Dashboard under
# Environment -> Add Environment Variable
# ============================================================

# [REQUIRED] Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# [REQUIRED] Verified sender address (domain must be verified in Resend).
# For testing on the free tier you can use: onboarding@resend.dev
CONTACT_FROM=TechPhilo Website <onboarding@resend.dev>
DEMO_FROM=TechPhilo Website <onboarding@resend.dev>

# [OPTIONAL] Recipient address for Demo form requests
DEMO_TO_EMAIL=techphilo.tp@gmail.com

# [OPTIONAL] Recipient address for Contact form requests
CONTACT_TO_EMAIL=techphilo.tp@gmail.com

# [AUTOMATIC] Set by Render Blueprint automatically:
# NODE_VERSION=20.19.0
