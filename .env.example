# ============================================================
# TECHPHILO — Render Environment Variables Example
# ============================================================
# Set these key-value pairs in Render Dashboard under
# Environment -> Add Environment Variable
# ============================================================

# [REQUIRED] Gmail address sending system emails
GMAIL_USER=techphilo.official@gmail.com

# [REQUIRED] Gmail 16-character App Password (generate at https://myaccount.google.com/apppasswords)
GMAIL_APP_PASS=abcd1234efgh5678

# [OPTIONAL] Recipient address for Demo form requests (defaults to GMAIL_USER if left blank)
DEMO_TO_EMAIL=sales@techphilo.com

# [OPTIONAL] Recipient address for Contact form requests (defaults to GMAIL_USER if left blank)
CONTACT_TO_EMAIL=support@techphilo.com

# [AUTOMATIC] Set by Render Blueprint automatically:
# NODE_VERSION=20.19.0
